# Stake Affiliate API tokens (Affiliate Program → API). Server-side only —
# never prefix them with VITE_, or they would be bundled into the browser code.
# The lowercase names (stake_com_api / stake_us_api) are accepted too.
STAKE_COM_API_TOKEN=
STAKE_US_API_TOKEN=

# Optional: full Stake usernames (comma separated) shown as "Hidden" on the board,
# for players who ask not to be named (see the Privacy Policy).
# LEADERBOARD_HIDDEN_USERS=

# ---------------------------------------------------------------- site address and search
# The public address, used in canonical links, share previews and sitemap.xml (no trailing slash).
# Read when the site is built. Defaults to the Vercel production domain, then to the one in shared/seo.ts.
# SITE_URL=https://example.com

# Google Search Console: the content value of the "HTML tag" verification method.
# GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Without it no analytics code is included.
# VITE_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------- contact form
# A Discord channel webhook URL. Messages from /contact are forwarded there.
# Without it the contact page shows the socials instead of the form.
# CONTACT_DISCORD_WEBHOOK=
